# These are set in Render (Environment tab), not in a file. This list is only a reminder.

# Database: the Supabase "Session pooler" connection string
DATABASE_URL=

# Any long random text
JWT_SECRET=

# ---- AI: set ONE of the two keys (or both) ----
# Free option (Google AI Studio, no card). Free-tier prompts may be used by Google to improve its products,
# so use made-up student data while testing.
GEMINI_API_KEY=
# Paid option (Anthropic Console, prepaid credit)
ANTHROPIC_API_KEY=

# Optional
# AI_PROVIDER=gemini        # or claude. If left out, Claude is used when its key exists, otherwise Gemini
# AI_MODEL=claude-haiku-5-5 # the cheap Claude model is the default
# GEMINI_MODEL=gemini-flash-latest
# AI_DAILY_LIMIT=30         # AI requests each person may make per day
