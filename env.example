# Copy this file to .env and fill in real values. Never commit the real .env file.

# Connection string from Supabase / Railway / Render Postgres.
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=

# From https://console.anthropic.com — required for the /ai/* routes to work.
# Note: this is a real, billed API key. It's different from the free key used
# automatically inside Claude.ai's own artifact preview.
ANTHROPIC_API_KEY=

PORT=4000

# From console.anthropic.com — kept server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=
